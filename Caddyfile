# Caddyfile for the portfolio container.
#
# Listens on HTTP :80 only — TLS is terminated upstream by Cloudflare
# (via cloudflared / Cloudflare Tunnel) or by another reverse proxy.
# Matches any host, so no SITE_DOMAIN var is required.
#
# If you'd rather have Caddy handle HTTPS + Let's Encrypt directly,
# replace `:80` with your public hostname (e.g. `portfolio.example.com`),
# republish ports 80/443 in docker-compose.yml, and mount a caddy-data
# volume at /data to persist certs across restarts.

:80 {
	root * /srv
	encode zstd gzip

	# Long-lived, content-hashed assets.
	@immutable path /_next/static/* /*.woff2 /*.woff /*.ttf
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML + metadata files — short cache, revalidated each visit.
	@html path / /*.html /sitemap.xml /robots.txt /index.txt
	header @html Cache-Control "public, max-age=300, must-revalidate"

	# Next exports `/opengraph-image` without a file extension, so help
	# scrapers (and aggressive mime-sniffers) by pinning the content type.
	@og path /opengraph-image
	header @og Content-Type image/png
	header @og Cache-Control "public, max-age=86400"

	# Cheap security headers.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	try_files {path} {path}.html {path}/index.html
	file_server
}
